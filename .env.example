# Kopiér til .env.local og udfyld. .env.local må ALDRIG committes.
# Find værdierne i Supabase: Project Settings -> API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# CAPTCHA på login (Cloudflare Turnstile). Site key er offentlig og må gerne ligge i NEXT_PUBLIC_.
# Den HEMMELIGE nøgle lægges kun i Supabase: Authentication → Attack Protection.
# Uden site key vises intet sikkerhedstjek. Lokale testnøgler fra Cloudflare:
#   1x00000000000000000000AA (godkender altid)  ·  2x00000000000000000000AB (afviser altid)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# AI-genkendelse af maskiner og vægtstakke. Kun på serveren – aldrig NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# AI_MODE: off | mock | live
#   off  = ingen AI, brugeren vælger selv (gratis)
#   mock = opdigtede testsvar, så hele flowet kan testes gratis
#   live = rigtige kald til Claude (kræver ANTHROPIC_API_KEY, koster tokens)
# Ikke sat: live hvis ANTHROPIC_API_KEY findes, ellers off.
AI_MODE=

# Valgfri: skift AI-model uden kodeændring (standard: claude-haiku-5-5, den billigste med billedforståelse)
LWN_AI_MODEL=

# Lokal udvikling med `npx supabase start` (værdier vises i terminalen):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key fra `npx supabase status`>

# Supabase hemmelig nøgle (Project Settings -> API Keys -> Secret keys). KUN på serveren.
# Bruges af Stripe-webhooken og AI-kvoterne til at skrive i subscriptions/ai_usage.
SUPABASE_SECRET_KEY=

# Stripe (LWN Pro). Brug sandbox-nøgler (sk_test_...) til test og preview.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Sidens adresse – bruges til Stripes retur-links
NEXT_PUBLIC_SITE_URL=https://lwn.dk
